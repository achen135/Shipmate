# Copy to .env.local and fill in. Never commit .env.local.
# `next build` runs with no env at all; without the Supabase pair, sign-in is
# disabled and app pages redirect to /sign-in.
# For local development against the local Supabase stack, don't edit this:
# run `npm run dev:local` (it reads keys from `supabase status`).

# Supabase project: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe in the browser; RLS still applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "true" shows the email magic-link option on /sign-in. Needs custom SMTP in
# production (Supabase's built-in sender only reaches the project's team).
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=

# Worker only (worker/run.ts, via GitHub Actions secrets in CI). Bypasses RLS:
# never import into app code. Secret key (sb_secret_…) or legacy service_role JWT.
# The worker reads SUPABASE_URL, falling back to NEXT_PUBLIC_SUPABASE_URL above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
