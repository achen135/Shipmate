# Copy to .env.local and fill in. Never commit .env.local.
# Nothing in M0 needs these to build: `next build` runs with no env at all.

# Supabase project: Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe in the browser; RLS still applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Worker only (worker/run.ts, via GitHub Actions secrets in CI). Bypasses RLS:
# never import into app code. Secret key (sb_secret_…) or legacy service_role JWT.
# The worker reads SUPABASE_URL, falling back to NEXT_PUBLIC_SUPABASE_URL above.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
